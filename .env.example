# ProjectX / TopstepX credentials
# Copy this file to .env and fill in your values.  Never commit .env.
TOPSTEP_USERNAME=your_username_here
TOPSTEP_API_KEY=your_api_key_here

# Optional — override the default API base URL
TOPSTEP_BASE=https://api.topstepx.com

# Directory where downloaded bar CSVs / SQLite databases are saved
DATA_DIR=data
